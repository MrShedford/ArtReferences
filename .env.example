# Copy this file to .env and fill in what you have. Everything here is
# optional — the app runs with none of it. Missing museum keys disable those
# museums; missing account vars hide sign-in and saving, and the wall behaves
# exactly as it did before accounts existed.
#
# Except where a comment says otherwise, these are SERVER-side vars (no VITE_
# prefix, deliberately). They're read only by the functions in api/ and never
# reach the browser — the client calls /api/museum instead of the museum
# directly. Don't add a VITE_ prefix to any of them: that would compile the
# key straight into the public bundle.
#
# Vite reads .env when the dev server STARTS. Restart it after editing.

# Smithsonian Institution Open Access
# Free, instant, self-serve signup at https://api.data.gov/signup/
# (registers you for the whole api.data.gov platform, Smithsonian included).
# The key is issued on the spot and emailed to you.
SMITHSONIAN_API_KEY=

# Harvard Art Museums
# Requested via a Google Form linked from https://github.com/harvardartmuseums/api-docs
# — this is manual/human-approved, not instant. Their terms restrict use to
# non-commercial purposes, cap you at 2500 requests/day, and forbid caching
# results beyond two weeks.
HARVARD_API_KEY=

# Europeana
# Free, but not auto-issued on signup: register a Europeana account at
# https://www.europeana.eu/en/for-developers and confirm the email, then
# request a key from the API key section of your account. A confirmation
# email arrives and the key appears there — fast, but it is a
# request-and-approve step, unlike Smithsonian's. A higher-rate "project key"
# can be requested from the same place.
# Aggregates ~4000 European institutions; per-item licensing varies
# (CC0/PDM/CC-BY/CC-BY-SA), unlike this app's CC0-only sources.
EUROPEANA_API_KEY=


# ── Accounts, lists and saving ───────────────────────────────────────────────
#
# These three work as a set. With any of them missing, /api/user returns 503,
# the sign-in button is replaced by "Sign-in unavailable", and no Save buttons
# render — search still works exactly as before.

# Neon Postgres connection string.
# https://console.neon.tech -> your project -> Connection string. Use the
# POOLED host (the one with "-pooler" in it) — @neondatabase/serverless talks
# HTTP and that's the endpoint built for it.
# Apply the schema once with `npm run db:push`, or by pasting db/schema.sql
# into Neon's SQL Editor.
DATABASE_URL=

# Secret used to sign the session cookie. Any long random string. Changing it
# invalidates every existing session, i.e. signs everyone out. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Google OAuth CLIENT ID for the "Sign in with Google" button.
#
# This is the one deliberate VITE_ exception in this project. Unlike every
# other var in this file it IS public and IS compiled into the bundle — an
# OAuth client ID is designed to be, and the button cannot work otherwise.
# There is no client SECRET anywhere: the browser hands Google's ID token to
# /api/user/session, which verifies it against Google's public keys. The api
# function reads this same var to check the token's `aud` claim.
#
# Create at https://console.cloud.google.com/apis/credentials
#   - Application type: Web application
#   - Authorized JavaScript origins: http://127.0.0.1:5173
#     (the dev server binds 127.0.0.1, NOT localhost — Google treats those as
#      different origins, and registering only localhost makes the button
#      silently refuse to render.) Add your production URL here too.
#   - Authorized redirect URIs: leave EMPTY. This is the token flow.
#
# On Vercel this must be set BEFORE the build runs, not just at runtime —
# VITE_ vars are baked in at build time, so adding it later needs a redeploy.
VITE_GOOGLE_CLIENT_ID=
