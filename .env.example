# Copy this file to .env and fill in the keys you have. All are optional —
# the app runs fine with none; those museums just stay disabled.

# Smithsonian Institution Open Access
# Free, instant, self-serve signup at https://api.data.gov/signup/
# (registers you for the whole api.data.gov platform, Smithsonian included).
VITE_SMITHSONIAN_API_KEY=

# Harvard Art Museums
# Requested via a Google Form linked from https://github.com/harvardartmuseums/api-docs
# — this is manual/human-approved, not instant. Their terms also restrict
# use to non-commercial purposes and forbid caching results beyond two weeks.
VITE_HARVARD_API_KEY=

# Europeana
# Free, instant, self-serve — a personal API key is auto-issued via your
# Europeana account at https://pro.europeana.eu/page/get-api (unlike
# Harvard's manual form). Aggregates ~4000 European institutions; per-item
# licensing varies (CC0/PDM/CC-BY/CC-BY-SA), unlike this app's CC0-only sources.
VITE_EUROPEANA_API_KEY=
